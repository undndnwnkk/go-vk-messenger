    {
      "name": "Create Group Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Backend team\",\n  \"user_ids\": [\n    \"{{bob_id}}\",\n    \"{{carol_id}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/chats/group",
        "description": "Creates a group chat owned by Alice with Bob and Carol as members and stores group_chat_id."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('group chat id is returned', function () { pm.expect(json.id).to.exist; });",
              "pm.collectionVariables.set('group_chat_id', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Group Members",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/chats/{{group_chat_id}}/members",
        "description": "Checks that the created group chat has Alice, Bob, and Carol as members."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('members response is an array', function () { pm.expect(json).to.be.an('array'); });",
              "pm.test('group has three members', function () { pm.expect(json.length).to.eql(3); });",
              "const ids = json.map(member => member.user_id);",
              "pm.test('all demo users are members', function () {",
              "  ['alice_id', 'bob_id', 'carol_id'].forEach(function (key) {",
              "    pm.expect(ids).to.include(pm.collectionVariables.get(key));",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Send Group Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"hello group\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/chats/{{group_chat_id}}/messages",
        "description": "Alice sends a message to the group chat."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('group message id is returned', function () { pm.expect(json.id).to.exist; });",
              "pm.collectionVariables.set('group_message_id', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Group History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{carol_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/chats/{{group_chat_id}}/messages?limit=50",
        "description": "Carol reads the group message history to demonstrate that another group member can see the message."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('history has messages', function () { pm.expect(json.messages).to.be.an('array'); });",
              "pm.test('group message is visible to Carol', function () {",
              "  pm.expect(json.messages.some(function (message) { return String(message.id) === String(pm.collectionVariables.get('group_message_id')); })).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
