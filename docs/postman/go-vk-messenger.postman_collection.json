{
  "info": {
    "name": "Go VK Messenger Smoke",
    "description": "Minimal REST smoke flow for Go VK Messenger. Set base_url before running. Tokens and IDs are saved into collection variables by test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "alice_username",
      "value": "alice"
    },
    {
      "key": "bob_username",
      "value": "bob"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "alice_token",
      "value": ""
    },
    {
      "key": "bob_token",
      "value": ""
    },
    {
      "key": "alice_id",
      "value": ""
    },
    {
      "key": "bob_id",
      "value": ""
    },
    {
      "key": "chat_id",
      "value": ""
    },
    {
      "key": "message_id",
      "value": ""
    },
    {
      "key": "group_chat_id",
      "value": ""
    },
    {
      "key": "carol_username",
      "value": "carol"
    },
    {
      "key": "carol_token",
      "value": ""
    },
    {
      "key": "carol_id",
      "value": ""
    },
    {
      "key": "group_message_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health is ok', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register Alice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{alice_username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register alice created or already exists', function () {",
              "  pm.expect([201, 409]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('alice_token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Register Bob",
